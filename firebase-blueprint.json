{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Information about the student",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "age": { "type": "number" },
        "gradeClass": { "type": "string", "maxLength": 20 },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "gradeClass"]
    },
    "ClassroomSession": {
      "title": "ClassroomSession",
      "description": "Saved lesson progress and state for a student",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "chapter": { "type": "string", "maxLength": 100 },
        "currentConcept": { "type": "string", "maxLength": 200 },
        "understandingEstimate": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["sessionId", "userId", "subject", "chapter"]
    }
  },
  "firestore": {
    "/students/{userId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Stores user student profile information"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ClassroomSession" },
      "description": "Stores classroom session progress and parent reports"
    }
  }
}
